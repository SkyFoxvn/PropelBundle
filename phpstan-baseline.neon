parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Propel\\Runtime\\ActiveRecord\\ActiveRecordInterface\:\:getByName\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: DataFixtures/Loader/AbstractDataLoader.php

		-
			message: '#^Call to an undefined method Propel\\Runtime\\ActiveRecord\\ActiveRecordInterface\:\:save\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: DataFixtures/Loader/AbstractDataLoader.php

		-
			message: '#^Call to an undefined method Propel\\Runtime\\ActiveRecord\\ActiveRecordInterface\:\:setByPosition\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: DataFixtures/Loader/AbstractDataLoader.php

		-
			message: '#^Call to an undefined method Propel\\Runtime\\Map\\TableMap\:\:doDeleteAll\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: DataFixtures/Loader/AbstractDataLoader.php

		-
			message: '#^Call to an undefined method Propel\\Runtime\\Map\\TableMap\:\:getFieldNames\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: DataFixtures/Loader/AbstractDataLoader.php

		-
			message: '#^Call to function is_array\(\) with array\<string, array\<string, mixed\>\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: DataFixtures/Loader/AbstractDataLoader.php

		-
			message: '#^Call to function is_array\(\) with array\<string, mixed\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: DataFixtures/Loader/AbstractDataLoader.php

		-
			message: '#^Variable \$relatedSetter might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: DataFixtures/Loader/AbstractDataLoader.php

		-
			message: '#^Variable \$setter might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: DataFixtures/Loader/AbstractDataLoader.php

		-
			message: '#^PHPDoc tag @var with type Symfony\\Component\\Config\\Definition\\Builder\\ParentNodeDefinitionInterface is not subtype of native type Symfony\\Component\\Config\\Definition\\Builder\\NodeDefinition\.$#'
			identifier: varTag.nativeType
			count: 1
			path: DependencyInjection/Security/UserProvider/PropelFactory.php

		-
			message: '#^Call to an undefined method Propel\\Runtime\\ActiveRecord\\ActiveRecordInterface\:\:getPrimaryKey\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Form/ChoiceList/PropelChoiceLoader.php

		-
			message: '#^Instanceof between Propel\\Runtime\\Map\\ColumnMap and Propel\\Runtime\\Map\\ColumnMap will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: Form/ChoiceList/PropelChoiceLoader.php

		-
			message: '#^Instanceof between Propel\\Runtime\\Collection\\ObjectCollection and Propel\\Runtime\\Collection\\ObjectCollection will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: Form/DataTransformer/CollectionToArrayTransformer.php

		-
			message: '#^Method Propel\\Bundle\\PropelBundle\\Form\\PropelExtension\:\:loadTypes\(\) return type with generic interface Symfony\\Component\\Form\\FormTypeInterface does not specify its types\: TData$#'
			identifier: missingType.generics
			count: 1
			path: Form/PropelExtension.php

		-
			message: '#^Class Propel\\Bundle\\PropelBundle\\Form\\Type\\ModelType extends generic class Symfony\\Component\\Form\\AbstractType but does not specify its types\: TData$#'
			identifier: missingType.generics
			count: 1
			path: Form/Type/ModelType.php

		-
			message: '#^Class Propel\\Bundle\\PropelBundle\\Form\\Type\\TranslationCollectionType extends generic class Symfony\\Component\\Form\\AbstractType but does not specify its types\: TData$#'
			identifier: missingType.generics
			count: 1
			path: Form/Type/TranslationCollectionType.php

		-
			message: '#^Class Propel\\Bundle\\PropelBundle\\Form\\Type\\TranslationType extends generic class Symfony\\Component\\Form\\AbstractType but does not specify its types\: TData$#'
			identifier: missingType.generics
			count: 1
			path: Form/Type/TranslationType.php

		-
			message: '#^Call to an undefined method Propel\\Runtime\\ActiveQuery\\ModelCriteria\:\:filterByPrimaryKey\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Request/ParamConverter/PropelParamConverter.php

		-
			message: '#^Instanceof between Sensio\\Bundle\\FrameworkExtraBundle\\Configuration\\ParamConverter and Sensio\\Bundle\\FrameworkExtraBundle\\Configuration\\ParamConverter will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: Request/ParamConverter/PropelParamConverter.php

		-
			message: '#^Call to an undefined method Symfony\\Component\\Security\\Core\\User\\UserInterface\:\:getPrimaryKey\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Security/User/PropelUserProvider.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 2
			path: Validator/Constraints/UniqueObject.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 2
			path: Validator/Constraints/UniqueObject.php

		-
			message: '#^Cannot access constant TABLE_MAP on class\-string\|false\.$#'
			identifier: classConstant.nonObject
			count: 1
			path: Validator/Constraints/UniqueObjectValidator.php
